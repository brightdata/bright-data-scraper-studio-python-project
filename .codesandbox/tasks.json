{
  "setupTasks": [
    {
      "name": "pip install -r requirements.txt",
      "command": "pip install -r requirements.txt"
    }
  ],
  "tasks": {
    "start": {
      "name": "Run Scraper Studio",
      "command": "python index.py",
      "runAtStart": false,
      "restartOn": {
        "files": ["index.py"]
      }
    },
    "install-dependencies": {
      "name": "Installing Dependencies",
      "command": "pip install -r requirements.txt",
      "restartOn": {
        "files": ["requirements.txt"]
      }
    }
  }
}
